# Public Supabase settings (same project as the web app's VITE_SUPABASE_*).
# Only the anon key belongs here; RLS protects each user's rows.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: the memex-scraper Worker (same as the web's VITE_SCRAPER_URL), for
# link titles and pictures when you save a link from the composer.
# EXPO_PUBLIC_SCRAPER_URL=https://memex-scraper.your-account.workers.dev

# Dev only: 1 = run on the built-in demo data with a fake signed-in user
# (ignored in release builds). `npm run fixtures` sets it for you.
# EXPO_PUBLIC_MEMEX_FIXTURES=1
