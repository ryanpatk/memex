{
  "expo": {
    "name": "memex",
    "slug": "memex",
    "scheme": "memex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.joyfulsystems.memex",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.joyfulsystems.memex"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f9fafb",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#13171d" }
        }
      ]
    ]
  }
}
