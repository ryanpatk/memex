{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memex-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "vars": {
    // Supabase project URL (the anon-visible one; the service key is a secret).
    "SUPABASE_URL": "https://zwgotlojioprtjvrxltc.supabase.co",
    // Optional: memex-scraper worker; enriches captures with page metadata.
    "SCRAPER_URL": "https://memex-scraper.joyfulsystems.workers.dev"
  },
  // Per-token rate limit (Workers rate limiting; counts are per Cloudflare
  // location, so it's a brake on runaway clients, not an exact quota).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ]
  // Secrets (set once, stored encrypted by Cloudflare):
  //   npx wrangler secret put SUPABASE_SERVICE_KEY
}
