{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memex-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "vars": {
    // Supabase project URL (the anon-visible one; the service key is a secret).
    "SUPABASE_URL": "https://zwgotlojioprtjvrxltc.supabase.co",
    // memex-scraper by URL: only a fallback for local dev. On Cloudflare a
    // Worker can't fetch another Worker's workers.dev URL (error 1042), so
    // production goes through the SCRAPER service binding below.
    "SCRAPER_URL": "https://memex-scraper.joyfulsystems.workers.dev"
  },
  // memex-scraper, called Worker-to-Worker (enriches captures with page metadata).
  "services": [{ "binding": "SCRAPER", "service": "memex-scraper" }],
  // Per-token rate limit (Workers rate limiting; counts are per Cloudflare
  // location, so it's a brake on runaway clients, not an exact quota).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // /mcp, per agent token (src/mcp/handler.ts).
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
  // Secrets (set once, stored encrypted by Cloudflare):
  //   npx wrangler secret put SUPABASE_SERVICE_KEY
}
