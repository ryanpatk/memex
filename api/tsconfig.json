{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Tests run under the root Vitest (npm test); they import vitest, which api/ doesn't install.
  "exclude": ["src/**/*.test.ts"]
}
